# One secret for everything: dashboard login, REST API (x-api-key header or ?key=), MCP URL.
API_KEY=change-me-to-a-long-random-string

# Postgres. Leave empty to use the embedded local database in ./data (good for local runs).
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4, works on Render).
DATABASE_URL=

# Optional: Supabase Storage for saved media (PDFs, images). Without it, saved media goes into the database.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=whatsapp-media

PORT=3000
TZ_NAME=Asia/Kolkata
LOG_LEVEL=info
# Public URL of this server (used to print the MCP URL). Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=
